{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "commonjs",
    "target": "ES2020"
  },
  "include": [
    "src/main/**/*",
    "src/preload.ts",
    "src/types/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "backend",
    "build",
    "src/renderer"
  ]
}
